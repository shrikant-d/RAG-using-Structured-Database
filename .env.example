# Copy to .env and fill in. .env is gitignored: never commit it.

# API key for the TU Ilmenau DBIS LLM server (Open WebUI -> Settings -> Account -> API keys)
TUI_LLM_API_KEY=

# Gemma 4 reasoning: "none" = off (default of this repo). Remove the line to use the server default (on).
TUI_REASONING_EFFORT=none

# Optional: other OpenAI-compatible endpoint serving gemma4:31b
# TUI_LLM_BASE_URL=https://dbhage.prakinf.tu-ilmenau.de/api/v1
